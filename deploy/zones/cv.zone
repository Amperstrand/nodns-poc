; Demo zone file for .cv
; This simulates what ARME's nameserver would serve
; Records are managed by nodns-bot via DDNS (RFC 2136)
;
; IMPORTANT: This is a LOCAL DEMO only. We are NOT the authoritative
; nameserver for .cv. This zone exists on our Knot DNS to prove
; the bot can update any zone. Real .cv integration requires ARME
; to run the bot on their infrastructure.

$TTL 300
$ORIGIN cv.

@       IN  SOA  ns1.nodns.shop. admin.nodns.shop. (
            2025060501  ; serial
            3600        ; refresh
            900         ; retry
            604800      ; expire
            300         ; minimum
        )

; Nameservers (ours for demo, would be ns.dns.cv etc. in production)
@       IN  NS   ns1.nodns.shop.
@       IN  NS   puck.nether.net.

; NoDNS registrar key (simulates ARME's signing key)
nodns-registrar IN TXT "nostr:npub1PLACEHOLDER_REPLACE_WITH_DEMO_KEY"

; ---- Below this line: records managed by nodns-bot ----
; npub1*.cv and delegated *.cv records added via DDNS
