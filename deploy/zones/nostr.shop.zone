; Zone file for nostr.shop
; Managed by nodns-bot via DDNS (RFC 2136)
; DO NOT edit manually — bot manages npub1* and delegated records

$TTL 3600
$ORIGIN nostr.shop.

@       IN  SOA  ns1.nodns.shop. admin.nodns.shop. (
            2025060501  ; serial
            3600        ; refresh
            900         ; retry
            604800      ; expire
            300         ; minimum
        )

; Nameservers (same infrastructure as nodns.shop)
@       IN  NS   ns1.nodns.shop.
@       IN  NS   ns2.nodns.shop.
@       IN  NS   puck.nether.net.

; Web server
@       IN  A    46.224.104.12
www     IN  A    46.224.104.12

; NoDNS registrar key (bootstrap for delegation verification)
nodns-registrar IN TXT "nostr:npub1PLACEHOLDER_REPLACE_WITH_REAL_KEY"

; ---- Below this line: records managed by nodns-bot ----
