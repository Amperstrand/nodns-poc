# Caddyfile for nodns production VPS (46.224.104.12)
# Deploy to /etc/caddy/Caddyfile
#
# This file contains ALL Caddy routes for the VPS, including:
# - nodns.shop API + frontend redirect
# - dns.nodns.shop DoH resolver (free + premium tiers)
# - Cashu ecosystem services (vipps.cashu.exchange, faucet, etc.)
# - EV charging infrastructure (opencpo, farm)
#
# Secrets: Caddyfile contains no secrets (TLS is on-demand via Let's Encrypt).
# The on_demand_tls ask endpoint validates domain ownership via the bot.

{
	on_demand_tls {
		ask http://127.0.0.1:9090/api/tls-check
	}
}

vipps.cashu.exchange {
	log {
	}
	root * /var/www/vipps.cashu.exchange

	@html path /index.html
	header @html Cache-Control "no-cache, no-store, must-revalidate"
	header @html Pragma "no-cache"
	header @html Expires "0"

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	handle /v1/* {
		reverse_proxy localhost:8085
	}

	handle /assets/* {
		file_server
		respond 404
	}

	handle /mint-proxy/* {
		uri strip_prefix /mint-proxy
		reverse_proxy https://testnut.cashu.space {
			header_up Host testnut.cashu.space
		}
		header {
			Access-Control-Allow-Origin *
			Access-Control-Allow-Methods "GET, POST, OPTIONS"
			Access-Control-Allow-Headers "Content-Type"
		}
	}

	handle {
		try_files {path} {path}/index.html /index.html
		file_server
	}
}

wallet.cashu.exchange {
	log {
	}
	redir https://temporarywallet.cashu.exchange{uri} permanent
}

